# Datos persistentes del contenedor de PostgreSQL (se montan desde ./data):
# son estado local de cada estudiante, no se versionan.
data/*
!data/.gitkeep

# La configuración/sesión de pgAdmin vive en un volumen nombrado de Docker.

# Variables de entorno locales; la plantilla versionada es .env.example.
.env

# Copias de seguridad locales
README_respaldo.md
scripts/*.bak-check
S19/S19-caso4-envios.sql
S19/S19-esquemas.sql
